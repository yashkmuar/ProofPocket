# ---------- App ----------
APP_NAME=ProofPocket API
ENV=local
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg://proofpocket:proofpocket@localhost:5432/proofpocket

# ---------- Azure OpenAI / Microsoft Foundry ----------
# Foundry portal -> your project -> Deployments

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2026-09-03

# These are DEPLOYMENT names you chose in Foundry, not model names
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# 1536 for text-embedding-3-small, 3072 for text-embedding-3-large
EMBEDDING_DIM=1536

# true = use az login / managed identity instead of an API key
USE_ENTRA_ID_AUTH=false

# ---------- RAG tuning ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5